<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="raiz" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.monedero.controlador.admin.DashboardAdminController">
    <left>
        <VBox spacing="8" style="-fx-background-color: #34495e;" prefWidth="180">
            <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>
            <Label text="Administrador" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button text="Inicio" maxWidth="Infinity" onAction="#abrir"/>
            <Button text="Clientes" maxWidth="Infinity" onAction="#abrir"/>
            <Button text="Rangos" maxWidth="Infinity" onAction="#abrir"/>
            <Button text="Procesos" maxWidth="Infinity" onAction="#abrir"/>
            <Button text="Reportes" maxWidth="Infinity" onAction="#abrir"/>
            <Button text="Cerrar sesión" maxWidth="Infinity" onAction="#cerrarSesion"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
            <Label text="Panel de administración" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <HBox spacing="20">
                <VBox spacing="5" style="-fx-background-color: #ecf0f1; -fx-padding: 15;" prefWidth="170">
                    <Label text="Clientes"/>
                    <Label fx:id="lblClientes" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" style="-fx-background-color: #ecf0f1; -fx-padding: 15;" prefWidth="170">
                    <Label text="Programadas pendientes"/>
                    <Label fx:id="lblPendientes" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>